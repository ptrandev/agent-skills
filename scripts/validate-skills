#!/bin/sh
set -eu

usage() {
  echo "usage: validate-skills [--links] [--scope all|repo|user] [--claude-dir DIR] [--codex-dir DIR]" >&2
  exit 2
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
skills_root=$repo_root/skills
check_links=false
selected_scope=all
claude_dir=${HOME}/.claude/skills
codex_dir=${HOME}/.agents/skills
repo_claude_dir=$repo_root/.claude/skills
repo_codex_dir=$repo_root/.agents/skills

while [ "$#" -gt 0 ]; do
  case "$1" in
    --links)
      check_links=true
      shift
      ;;
    --scope)
      [ "$#" -ge 2 ] || usage
      selected_scope=$2
      shift 2
      ;;
    --claude-dir)
      [ "$#" -ge 2 ] || usage
      claude_dir=$2
      shift 2
      ;;
    --codex-dir)
      [ "$#" -ge 2 ] || usage
      codex_dir=$2
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

case "$selected_scope" in
  all|repo|user) ;;
  *) usage ;;
esac

status=0
count=0

if [ -L "$repo_root/CLAUDE.md" ] || [ ! -f "$repo_root/CLAUDE.md" ] || [ "$(cat "$repo_root/CLAUDE.md")" != @AGENTS.md ]; then
  echo "ERROR CLAUDE.md must contain only @AGENTS.md" >&2
  status=1
fi

check_link() {
  host=$1
  source_dir=$2
  target_root=$3
  skill_name=$(basename -- "$source_dir")
  link_path=$target_root/$skill_name

  if [ ! -L "$link_path" ]; then
    echo "ERROR $host link missing: $link_path" >&2
    status=1
    return
  fi
  if [ ! -d "$link_path" ] || [ "$(CDPATH= cd -- "$link_path" && pwd -P)" != "$(CDPATH= cd -- "$source_dir" && pwd -P)" ]; then
    echo "ERROR $host link has wrong target: $link_path" >&2
    status=1
  fi
}

check_generated_links() {
  source_dir=$1
  skill_name=$(basename -- "$source_dir")

  if [ "$selected_scope" = all ] || [ "$selected_scope" = repo ]; then
    if [ "$skill_name" != claude ]; then
      check_link repo-claude "$source_dir" "$repo_claude_dir"
    fi
    check_link repo-codex "$source_dir" "$repo_codex_dir"
  fi

  if [ "$selected_scope" = all ] || [ "$selected_scope" = user ]; then
    if [ "$skill_name" != claude ]; then
      check_link user-claude "$source_dir" "$claude_dir"
    fi
    check_link user-codex "$source_dir" "$codex_dir"
  fi
}

if [ ! -d "$skills_root" ]; then
  echo "ERROR skills directory missing: $skills_root" >&2
  exit 1
fi

for skill_file in "$skills_root"/*/SKILL.md; do
  [ -f "$skill_file" ] || continue
  count=$((count + 1))
  skill_dir=$(dirname -- "$skill_file")
  skill_name=$(basename -- "$skill_dir")
  first_line=$(sed -n '1p' "$skill_file")
  declared_name=$(awk '
    NR == 1 && $0 == "---" { in_frontmatter=1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter && $1 == "name:" { print $2; exit }
  ' "$skill_file")
  has_description=$(awk '
    NR == 1 && $0 == "---" { in_frontmatter=1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter && $1 == "description:" { found=1 }
    END { print found ? "yes" : "no" }
  ' "$skill_file")

  if [ "$first_line" != "---" ]; then
    echo "ERROR $skill_name: SKILL.md must start with ---" >&2
    status=1
  fi
  if [ "$declared_name" != "$skill_name" ]; then
    echo "ERROR $skill_name: frontmatter name is '$declared_name'" >&2
    status=1
  fi
  if [ "$has_description" != yes ]; then
    echo "ERROR $skill_name: frontmatter description is missing" >&2
    status=1
  fi
  case "$skill_name" in
    *[!a-z0-9-]*|'')
      echo "ERROR $skill_name: directory name must use lowercase letters, digits, and hyphens" >&2
      status=1
      ;;
  esac
  if grep -rIqE 'TODO: Replace|\[TODO\]|YOUR_SKILL_NAME' "$skill_dir"; then
    echo "ERROR $skill_name: unfinished scaffold placeholder" >&2
    status=1
  fi

  if [ "$check_links" = true ]; then
    check_generated_links "$skill_dir"
  fi
done

if [ "$check_links" = true ]; then
  if [ -d "$skills_root/shared" ]; then
    check_generated_links "$skills_root/shared"
  fi
  if { [ "$selected_scope" = all ] || [ "$selected_scope" = repo ]; } && { [ -e "$repo_claude_dir/claude" ] || [ -L "$repo_claude_dir/claude" ]; }; then
    echo "ERROR Claude Code must not expose the Codex-only claude skill: $repo_claude_dir/claude" >&2
    status=1
  fi
  if { [ "$selected_scope" = all ] || [ "$selected_scope" = user ]; } && { [ -e "$claude_dir/claude" ] || [ -L "$claude_dir/claude" ]; }; then
    echo "ERROR Claude Code must not expose the Codex-only claude skill: $claude_dir/claude" >&2
    status=1
  fi
fi

if [ "$count" -eq 0 ]; then
  echo "ERROR no skills found under $skills_root" >&2
  exit 1
fi

if [ "$status" -eq 0 ]; then
  echo "validated $count skills"
fi
exit "$status"
